# Entity: article

main: kit: entity: article: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: false
      short: "Article author"
      type: "`$STRING`"
    }
    {
      name: "category"
      req: false
      short: "Article category"
      type: "`$STRING`"
    }
    {
      name: "content"
      req: false
      short: "Article content"
      type: "`$STRING`"
    }
    {
      name: "publishedDate"
      req: false
      short: "Publication date"
      type: "`$STRING`"
    }
    {
      name: "slug"
      req: false
      short: "Article slug"
      type: "`$STRING`"
    }
    {
      name: "tags"
      req: false
      short: "Article tags"
      type: "`$ARRAY`"
    }
    {
      name: "title"
      req: false
      short: "Article title"
      type: "`$STRING`"
    }
  ]

  name: "article"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: false
                kind: "query"
                name: "eu"
                orig: "eu"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                kind: "query"
                name: "slug"
                orig: "slug"
                reqd: true
                type: "`$ARRAY`"
              }
            ]
          }
          method: "GET"
          orig: "/get/slugs"
          parts: [
            "get"
            "slugs"
          ]
          select: {
            exist: [
              "eu"
              "slug"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

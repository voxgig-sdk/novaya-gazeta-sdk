# Entity: theme

main: kit: entity: theme: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      short: "Theme description"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Theme identifier"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Theme name"
      type: "`$STRING`"
    }
    {
      name: "slug"
      req: false
      short: "URL slug for the theme"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "theme"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/get/themes"
          parts: [
            "get"
            "themes"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
